ull in skin wall</text>\n<text x=88 y=420 class=s>tension runs around circle, not across it</text>\n<text x=44 y=68 class=s>cabin air pressure &#8594; pushes out (kPa)</text>\n</g>\n<!-- connector -->\n<path d=\"M390 200 L530 150 L530 360 L390 300\" fill=none stroke=\"#2a3a52\" stroke-width=\"1.2\" stroke-dasharray=\"6 6\"/>\n<g>\n<text x=544 y=42 class=lbl>wall magnified &#183; corrugated sandwich</text>\n<g id=wallBox>\n<rect x=540 y=90 width=276 height=250 rx=12 fill=\"#0a1220\" stroke=\"#25344b\" stroke-width=\"1.2\"/>\n<!-- liners -->\n<rect id=linerTop x=560 y=130 width=236 height=10 rx=3 fill=\"#d8b37c\"/>\n<rect id=linerBot x=560 y=270 width=236 height=10 rx=3 fill=\"#d8b37c\"/>\n<path id=flute d=\"\" fill=none stroke=\"#9ec7ff\" stroke-width=\"3.2\" stroke-linecap=\"round\"/>\n<g id=cracks stroke=\"#ff6b6b\" stroke-width=\"2\" stroke-linecap=\"round\" filter=\"url(#gl)\"></g>\n<g id=tArrows></g>\n</g>\n<text x=560 y=122 class=s>liner</text>\n<text x=560 y=304 class=s>liner</text>\n<text x=560 y=248 class=s>flute &#183; glue line</text>\n<text x=544 y=370 class=t>wall stretches &#183; fibres separate</text>\n<text x=544 y=388 class=s>thin skin &#215; wide radius concentrates pull (m)</text>\n<text x=544 y=406 class=s>allowable divided by safety factor (kPa, ratio)</text>\n</g>\n<!-- stress strip -->\n<g>\n<text x=44 y=438 class=s>mechanism: pressure &#215; radius / thickness = membrane pull &#183; animation scaled by live inputs</text>\n</g>\n</svg>\n</div>\n<script>\n(function(){\nconst V=window.VIBLOOM||{};const P={};(V.params||[]).forEach(o=>{P[o.name]=o.value});\nconst dp=P.delta_p, R=P.fuselage_radius, th=P.skin_thickness, al=P.cardboard_tensile_allowable, sf=P.safety_factor;\nconst hoop=dp*R/th; const cap=al/sf; const over=hoop/cap;\nconst NS='http://www.w3.org/2000/svg';\nconst cx=250, cy=250, r0=128;\nconst pg=document.getElementById('parrows');\nconst dots=document.getElementById('dots');\nconst N=16;\nfor(let i=0;i<N;i++){\n const a=i/N*Math.PI*2;\n const x1=cx+Math.cos(a)*(r0-18), y1=cy+Math.sin(a)*(r0-18);\n const x2=cx+Math.cos(a)*(r0+44), y2=cy+Math.sin(a)*(r0+44);\n const l=document.createElementNS(NS,'line');\n l.setAttribute('x1',x1);l.setAttribute('y1',y1);l.setAttribute('x2',x2);l.setAttribute('y2',y2);\n l.setAttribute('stroke','#7cc4ff');l.setAttribute('stroke-width','2');l.setAttribute('marker-end','url(#ah)');l.setAttribute('opacity','.9');\n l.dataset.a=a; pg.appendChild(l);\n}\nfor(let i=0;i<42;i++){\n const c=document.createElementNS(NS,'circle');\n c.setAttribute('r',(3+Math.random()*4).toFixed(1));\n c.setAttribute('fill','#7cc4ff');c.setAttribute('opacity',(.12+Math.random()*.28).toFixed(2));\n c.dataset.s=Math.random()*6.28; c.dataset.rr=Math.random()*92; dots.appendChild(c);\n}\nconst fl=document.getElementById('flute');\n(function(){\n let d='M 560 200 ';\n const w=236, n=9, amp=34, y0=200;\n for(let s=0;s<=120;s++){\n  const x=560+w*s/120; const y=y0+Math.sin(s/120*n*Math.PI*2)*amp*.5+Math.sin(s/120*n*Math.PI*2-Math.PI/2)*amp*.28;\n  d+=(s===0?'':'L ')+x.toFixed(1)+' '+y.toFixed(1)+' ';\n }\n fl.setAttribute('d',d);\n})();\nconst cg=document.getElementById('cracks');\nconst cn=Math.max(4,Math.min(10,Math.round(over*5)));\nfor(let i=0;i<cn;i++){\n const x=590+Math.random()*170;\n const p=document.createElementNS(NS,'path');\n const j=(Math.random()*14-7).toFixed(1);\n p.setAttribute('d','M '+x.toFixed(0)+' 132 l '+j+' 22 l '+(-j)+' 18 l 6 18');\n p.setAttribute('fill','none');p.dataset.ph=Math.random()*6.28;\n cg.appendChild(p);\n}\nconst tg=document.getElementById('tArrows');\n[[548,205,522,205],[808,205,834,205]].forEach(v=>{\n const l=document.createElementNS(NS,'line');\n l.setAttribute('x1',v[0]);l.setAttribute('y1',v[1]);l.setAttribute('x2',v[2]);l.setAttribute('y2',v[3]);\n l.setAttribute('stroke','#ffb86b');l.setAttribute('stroke-width','2.4');l.setAttribute('marker-end','url(#ah2)');\n tg.appendChild(l);\n});\nconst ringO=document.getElementById('ringOuter');\nconst ringI=docume
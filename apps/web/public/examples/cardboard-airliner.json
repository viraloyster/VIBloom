        "title": "Cardboard fuselage overload",
        "html": "<style>*{box-sizing:border-box;margin:0;padding:0}html,body{height:100%}#w{position:fixed;inset:0;background:#05070b;color:#e8eef6;font-family:system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;display:flex;flex-direction:column;padding:14px 16px;overflow:hidden}#w::before{content:\"\";position:absolute;inset:0;background:radial-gradient(900px 500px at 70% 10%,rgba(56,189,248,.10),transparent 60%),radial-gradient(700px 500px at 10% 90%,rgba(244,63,94,.08),transparent 60%);pointer-events:none}header{display:flex;align-items:center;gap:10px;z-index:1}header .dot{width:10px;height:10px;border-radius:50%;background:#f43f5e;box-shadow:0 0 12px #f43f5e;animation:blink 1.6s infinite}header h1{font-size:clamp(11px,1.6vw,14px);font-weight:700;letter-spacing:.08em;text-transform:uppercase}header h1 span{color:#8ea0b5;font-weight:500;letter-spacing:.02em;text-transform:none}#badge{margin-left:auto;font-size:11px;font-weight:800;letter-spacing:.12em;padding:5px 11px;border-radius:99px;border:1px solid #f43f5e;color:#f43f5e;background:rgba(244,63,94,.12)}h2{font-size:clamp(18px,3.2vw,30px);font-weight:800;line-height:1.05;z-index:1}h2 em{font-style:normal;color:#38bdf8}.sub{color:#8ea0b5;font-size:clamp(11px,1.5vw,13px);z-index:1;margin-top:4px}main{flex:1;display:grid;grid-template-columns:1.35fr .85fr;gap:14px;margin-top:12px;min-height:0;z-index:1}@media(max-width:700px){main{grid-template-columns:1fr;overflow:auto}}.card{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.10);border-radius:16px;padding:12px;position:relative;display:flex;flex-direction:column;min-height:0;overflow:hidden}.card h3{font-size:11px;letter-spacing:.14em;color:#8ea0b5;text-transform:uppercase;margin-bottom:8px}#planeWrap{flex:1;display:flex;align-items:center;justify-content:center;min-height:0}svg{width:100%;height:100%;max-height:300px}.flow{stroke-dasharray:7 9;animation:dash 1.1s linear infinite}@keyframes dash{to{stroke-dashoffset:-32}}@keyframes blink{0%,100%{opacity:1}50%{opacity:.35}}.crush{transform-origin:center;transform-box:fill-box}#bars{flex:1;display:flex;align-items:flex-end;justify-content:center;gap:22px;min-height:140px;padding-top:18px}.col{display:flex;flex-direction:column;align-items:center;gap:8px;height:100%;justify-content:flex-end}.track{width:64px;height:100%;min-height:140px;max-height:230px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);border-radius:12px;position:relative;overflow:visible;display:flex;align-items:flex-end}.fill{width:100%;border-radius:11px;position:relative;transition:height 1s}.fill.load{background:linear-gradient(180deg,#fb7185,#e11d48);box-shadow:0 0 22px rgba(244,63,94,.55)}.fill.cap{background:linear-gradient(180deg,#38bdf8,#0369a1);box-shadow:0 0 14px rgba(56,189,248,.4)}.vlab{font-size:13px;font-weight:800}.vlab small{font-weight:600;color:#8ea0b5;font-size:11px}.clab{font-size:11px;color:#cbd5e1;text-align:center;line-height:1.3}.vs{font-size:22px;font-weight:900;color:#f43f5e}.ratio{margin-top:10px;text-align:center;background:rgba(244,63,94,.10);border:1px solid rgba(244,63,94,.4);border-radius:12px;padding:8px;font-size:clamp(12px,1.8vw,14px);font-weight:700}#kids{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}.kid{flex:1;min-width:110px;font-size:11px;padding:7px 9px;border-radius:10px;background:rgba(255,255,255,.05);border:1px solid rgba(244,63,94,.35);color:#fecdd3;display:flex;gap:7px;align-items:center}footer{display:flex;justify-content:space-between;color:#64748b;font-size:11px;margin-top:10px;z-index:1}</style><div id=\"w\"><header><div class=\"dot\"></div><h1 id=\"goal\">AIRLINER <span id=\"goalSub\"></span></h1><div id=\"badge\">BROKEN</div></header><h2>Can <em>cardboard</em> carry flight loads?</h2><div class=\"sub\" id=\"stmt\"></div><main><div class=\"card\"><h3>Fuselage + wing &mdash; limit load sketch</h3><div id=\"planeWrap\"><svg viewBox=\"0 0 520 300\" preserveAspectRatio=\"xMidYMid meet\"><defs><pattern id=\"corr\" width=\"10\" height=\"8\" patternUnits=\"userSpaceOnUse\"><rect width=\"10\" height=\"8\" fill=\"#101a28\"/><path d=\"M0 4 Q2.5 1 5 4 T10 4\" stroke=\"#38bdf8\" stroke-width=\"1\" fill=\"none\" opacity=\".7\"/></pattern><filter id=\"glow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\"><feGaussianBlur stdDeviation=\"3\" result=\"b\"/><feMerge><feMergeNode in=\"b\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter></defs><g id=\"wingL\" opacity=\".95\"><path d=\"M250 140 L60 90 L60 170 L250 165 Z\" fill=\"url(#corr)\" stroke=\"#38bdf8\" stroke-width=\"1.5\"/></g><g id=\"wingR\" opacity=\".95\"><path d=\"M270 140 L460 90 L460 170 L270 165 Z\" fill=\"url(#corr)\" stroke=\"#38bdf8\" stroke-width=\"1.5\"/></g><path class=\"flow\" d=\"M40 110 L240 150\" stroke=\"#38bdf8\" stroke-width=\"2\" fill=\"none\" opacity=\".8\"/><path class=\"flow\" d=\"M480 110 L280 150\" stroke=\"#38bdf8\" stroke-width=\"2\" fill=\"none\" opacity=\".8\"/><g id=\"arrows\"><path d=\"M130 60 L130 95\" stroke=\"#f43f5e\" stroke-width=\"3\" marker-end=\"url(#a)\" filter=\"url(#glow)\"/><path d=\"M390 60 L390 95\" stroke=\"#f43f5e\" stroke-width=\"3\" marker-end=\"url(#a)\" filter=\"url(#glow)\"/><path d=\"M260 230 L260 195\" stroke=\"#38bdf8\" stroke-width=\"2\" stroke-dasharray=\"4 4\"/><text x=\"266\" y=\"245\" fill=\"#8ea0b5\" font-size=\"11\">lift</text><text x=\"100\" y=\"55\" fill=\"#f43f5e\" font-size=\"12\" font-weight=\"800\" id=\"loadLab\">load</text></g><defs><marker id=\"a\" markerWidth=\"8\" markerHeight=\"8\" refX=\"4\" refY=\"4\" orient=\"auto\"><path d=\"M0 0 L8 4 L0 8 Z\" fill=\"#f43f5e\"/></marker></defs><g id=\"fuse\"><rect x=\"235\" y=\"90\" width=\"50\" height=\"130\" rx=\"25\" fill=\"url(#corr)\" stroke=\"#e8eef6\" stroke-width=\"2\"/><ellipse cx=\"260\" cy=\"90\" rx=\"25\" ry=\"10\" fill=\"#1a2a44\" stroke=\"#e8eef6\" stroke-width=\"2\"/><g id=\"cracks\" stroke=\"#f43f5e\" stroke-width=\"2.5\" stroke-linecap=\"round\" filter=\"url(#glow)\"><path d=\"M242 125 L275 135 L245 145\" fill=\"none\"/><path d=\"M242 165 L270 175 L248 190\" fill=\"none\"/></g><text x=\"260\" y=\"155\" text-anchor=\"middle\" fill=\"#fff\" font-size=\"10\" font-weight=\"700\">CARDBOARD</text></g><g id=\"puffs\"></g></svg></div><div id=\"kids\"></div></div><div class=\"card\"><h3>Stress vs strength &mdash; must hold below</h3><div id=\"bars\"><div class=\"col\"><div class=\"track\"><div class=\"fill load\" id=\"fLoad\" style=\"height:100%\"></div></div><div class=\"vlab\" id=\"vLoad\" style=\"color:#f43f5e\"></div><div class=\"clab\" id=\"lLoad\"></div></div><div class=\"vs\">&times;</div><div class=\"col\"><div class=\"track\"><div class=\"fill cap\" id=\"fCap\" style=\"height:5%\"></div></div><div class=\"vlab\" id=\"vCap\" style=\"color:#38bdf8\"></div><div class=\"clab\" id=\"lCap\"></div></div></div><div class=\"ratio\" id=\"ratio\"></div></div></main><footer><span id=\"desc\"></span><span>LIVE &bull; FAR 25 LIMIT</span></footer></div><script>(function(){var VB=window.VIBLOOM||{};var D=VB.data||VB||{};var node=D.node||{};var check=D.check||{};var params=D.params||[];var kids=node.children||D.children||[];function num(v){return (typeof v===\"number\"&&isFinite(v))?v:parseFloat(v)}var val=num(check.value);var lim=num(check.limit);var unit=check.unit||\"MPa\";var pass=!!check.pass;function param(n){for(var i=0;i<params.length;i++){if(params[i].name===n) return params[i]}return {}}var pLoad=param(\"design_stress_mpa\");var pCap=param(\"cardboard_strength_mpa\");document.getElementById(\"goal\").firstChild.textContent=(D.goal||\"TEST\").toUpperCase().slice(0,44)+\" \";document.getElementById(\"stmt\").textContent=node.statement||check.description||\"\";document.getElementById(\"desc\").textContent=check.description||\"\";var b=document.getElementById(\"badge\");b.textContent=(node.status||(pass?\"HOLDS\":\"BROKEN\")).toUpperCase();var good=\"#22c55e\",bad=\"#f43f5e\";b.style.color=pass?good:bad;b.style.borderColor=pass?good:bad;b.querySelector;document.querySelector(\"#w .dot\").style.background=pass?good:bad;document.querySelector(\"#w .dot\").style.boxShadow=\"0 0 12px \"+(pass?good:bad);var ratio=val/lim;document.getElementById(\"vLoad\").innerHTML=val+\" <small>\"+unit+\"</small>\";document.getElementById(\"vCap\").innerHTML=lim+\" <small>\"+unit+\"</small>\";document.getElementById(\"lLoad\").textContent=(pLoad.label||\"design stress\");document.getElementById(\"lCap\").textContent=(pCap.label||\"cardboard strength\");document.getElementById(\"loadLab\").textContent=val+\" \"+unit+\" DOWN\";var r=document.getElementById(\"ratio\");if(!pass){r.style.color=\"#fecdd3\";r.innerHTML=\"Over by <b style='color:\"+bad+\";font-size:1.25em'>\"+ratio.toFixed(0)+\"&times;</b> &mdash; skin crushes & buckles.\"}else{r.style.color=\"#bbf7d0\";r.textContent=\"Holds with margin.\"}var fc=document.getElementById(\"fCap\");var h=Math.max(val,lim)>0?(lim/Math.max(val,lim)*100):0;fc.style.height=Math.max(h,3)+\"%\";var box=document.getElementById(\"kids\");(kids||[]).forEach(function(k){var d=document.createElement(\"div\");d.className=\"kid\";d.innerHTML=\"<span style='width:8px;height:8px;border-radius:50%;background:\"+(pass?good:bad)+\";box-shadow:0 0 8px \"+(pass?good:bad)+\"'></span>\"+(k.title||\"sub-check\")+\" &bull; \"+(k.status||\"broken\");if(pass){d.style.borderColor=\"rgba(34,197,94,.35)\";d.style.color=\"#bbf7d0\"}box.appendChild(d)});var t=0;var wL=document.getElementById(\"wingL\"),wR=document.getElementById(\"wingR\"),cr=document.getElementById(\"cracks\"),pu=document.getElementById(\"puffs\");function puff(x,y){var c=document.createElementNS(\"http://www.w3.org/2000/svg\",\"circle\");c.setAttribute(\"cx\",x);c.setAttribute(\"cy\",y);c.setAttribute(\"r\",3+Math.random()*4);c.setAttribute(\"fill\",\"none\");c.setAttribute(\"stroke\",pass?\"#22c55e\":\"#f43f5e\");c.setAttribute(\"stroke-width\",\"2\");c.setAttribute(\"opacity\",\".9\");pu.appendChild(c);var r0=parseFloat(c.getAttribute(\"r\"));var o=0;var iv=setInterval(function(){o+=.07;r0+=1.4;c.setAttribute(\"r\",r0);c.setAttribute(\"opacity\",Math.max(0,.9-o));if(o>.9){clearInterval(iv);c.remove()}},50)}setInterval(function(){t+=.08;var bend=Math.sin(t*2)*(pass?1.5:6);wL.setAttribute(\"transform\",\"rotate(\"+(-bend*.4)+\" 260 155)\");wR.setAttribute(\"transform\",\"rotate(\"+(bend*.4)+\" 260 155)\");cr.setAttribute(\"opacity\",pass?.25:(.55+.45*Math.sin(t*3)));cr.setAttribute(\"transform\",\"scale(\"+(1+.06*Math.sin(t*5))+\")\");if(!pass&&Math.random()<.35)puff(235+Math.random()*50,115+Math.random()*85)},80);})();</script>",

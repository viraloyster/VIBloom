{
  "name": "vibloom",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:text",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:text": "node scripts/check-text.mjs",
    "test": "vitest run",
    "build": "npm run build -w @vibloom/web",
    "dev": "npm run dev -w @vibloom/web"
  },
  "prettier": {
    "printWidth": 100
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
